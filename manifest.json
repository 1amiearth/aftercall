{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "__MSG_extName__"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/utterance.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_cmdToggle__"
    },
    "mark-moment": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_cmdMark__"
    }
  }
}
